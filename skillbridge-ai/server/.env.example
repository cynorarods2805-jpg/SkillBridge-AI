# Copy to .env and change the secret before deploying.
PORT=3001
# Used by Better Auth to sign sessions. Use a long random string (32+ chars).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public URL of the API server
BETTER_AUTH_URL=http://localhost:3001
# Extra browser origins allowed to call the auth API (comma separated)
CLIENT_ORIGIN=http://localhost:5173
# Optional: custom database file location
# DB_PATH=./skillbridge.db
